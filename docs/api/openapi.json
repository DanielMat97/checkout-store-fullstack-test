{
  "openapi": "3.0.3",
  "info": {
    "title": "Checkout Store API",
    "version": "0.1.0",
    "description": "Single Serverless Framework HTTP API. Import into Apidog. Update on every endpoint change."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "serverless offline / deployed HttpApi"
    }
  ],
  "paths": {
    "/products/health": {
      "get": {
        "tags": ["products"],
        "summary": "Products service health",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/customers/health": {
      "get": {
        "tags": ["customers"],
        "summary": "Customers service health",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/deliveries/health": {
      "get": {
        "tags": ["deliveries"],
        "summary": "Deliveries service health",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/transactions/health": {
      "get": {
        "tags": ["transactions"],
        "summary": "Transactions service health",
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
