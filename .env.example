# Payment gateway (sandbox) — never commit real values; never put provider brand in repo
PAYMENT_API_URL=
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_EVENTS_KEY=
PAYMENT_INTEGRITY_KEY=
PAYMENT_CURRENCY=COP
# sandbox (default) | fake | APPROVED | DECLINED | ERROR
PAYMENT_GATEWAY_MODE=fake

# HashiCorp Vault (optional local — see docs/vault.md)
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=root
# Prefer: npm run vault:up && npm run vault:seed && npm run vault:export -- --stage=dev --out=.env.vault

# AWS / DynamoDB (single-table; see docs/data-model.md)
AWS_REGION=us-east-1
# Local: fixed name. Deployed stages default to checkout-store-<stage> if unset.
DYNAMODB_TABLE_NAME=checkout-store
# Local DynamoDB (docker compose): http://localhost:8000 — leave empty for real AWS
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Fees (minor currency units, e.g. cents)
BASE_FEE=1500
DELIVERY_FEE=5000

# Serverless HTTP API (local offline + deploy)
# Comma-separated origins allowed (prod Amplify URL + localhost for FB)
CORS_ORIGIN=http://localhost:5173

# Optional: SNS email for CloudWatch alarms (4xx/5xx/latency/Lambda errors)
# OBSERVABILITY_ALERT_EMAIL=ops@example.com

# Frontend
VITE_MOCK_MODE=true
VITE_API_BASE_URL=http://localhost:3000
# Set VITE_MOCK_MODE=false to use live API (customer → tx PENDING → pay)
VITE_BASE_FEE=1500
VITE_DELIVERY_FEE=5000

# Local / CI Playwright E2E (see docs/ci-cd.md)
# FE_BASE_URL=http://localhost:5173
# API_BASE_URL=http://localhost:3000
# Optional Artillery stress: npm run test:stress (set API_BASE_URL)
# STRESS_ENABLED=false  # GitHub var to skip Artillery in deploy workflows
