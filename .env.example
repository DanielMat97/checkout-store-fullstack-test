# Payment gateway (sandbox) — never commit real values to public remotes with brand names
PAYMENT_API_URL=
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_EVENTS_KEY=
PAYMENT_INTEGRITY_KEY=

# AWS / DynamoDB
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=checkout-store
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Fees (minor currency units, e.g. cents)
BASE_FEE=1500
DELIVERY_FEE=5000

# Serverless HTTP API (local offline + deploy)
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_MOCK_MODE=true
VITE_API_BASE_URL=http://localhost:3000
