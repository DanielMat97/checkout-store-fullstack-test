# Payment gateway (sandbox) — never commit real values to public remotes with brand names
PAYMENT_API_URL=
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_EVENTS_KEY=
PAYMENT_INTEGRITY_KEY=

# AWS / DynamoDB
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=checkout-store
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Fees (minor currency units, e.g. cents)
BASE_FEE=1500
DELIVERY_FEE=5000

# Single API Gateway entry (local proxy)
GATEWAY_PORT=3000
PRODUCTS_SERVICE_URL=http://127.0.0.1:3001
CUSTOMERS_SERVICE_URL=http://127.0.0.1:3002
DELIVERIES_SERVICE_URL=http://127.0.0.1:3003
TRANSACTIONS_SERVICE_URL=http://127.0.0.1:3004
CORS_ORIGIN=http://localhost:5173

# Frontend — one base URL through the gateway
VITE_API_BASE_URL=http://localhost:3000
